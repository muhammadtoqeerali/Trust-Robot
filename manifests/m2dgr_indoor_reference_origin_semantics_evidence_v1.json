        "maintainer_comments": [
          {
            "author_login": "sjtuyinjie",
            "body": "As mentioned in the paper, the ground truth trajectories of Room and Roomdark sequences are obtained by Mocap. In fact, Mocap paremeters are not necessary, because when you evaluate your SLAM result, the \"-a\" command of EVO will align the GT with your trajectories. We do not have to specially calibrate the extrinsics between LiDAR and Mocap.",
            "comment_id": 1015447312,
            "created_at": "2022-01-18T14:09:48Z",
            "updated_at": "2022-01-18T14:09:48Z",
            "web_url": "https://github.com/SJTU-ViSYS/M2DGR/issues/9#issuecomment-1015447312"
          },
