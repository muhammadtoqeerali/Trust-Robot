{
  "version": "v2",
  "purpose": "Deterministic sample-specific IMU reliability evaluation",
  "channels": [
    "accel_x",
    "accel_y",
    "accel_z",
    "gyro_x",
    "gyro_y",
    "gyro_z"
  ],
  "corruptions": {
    "missing_channel": {
      "type": "categorical",
      "channel_indices": [0, 1, 2, 3, 4, 5]
    },
    "random_dropout": {
      "type": "stochastic",
      "drop_ratio": [0.1, 0.25, 0.5]
    },
    "gaussian_noise": {
      "type": "stochastic",
      "snr_db": [20, 10, 5]
    },
    "sensor_drift": {
      "type": "stochastic_condition",
      "bias_scale": [0.1, 0.25, 0.5]
    }
  },
  "corruption_seeds": [42, 123, 2026],
  "aggregation": {
    "within_family": "mean_over_conditions_and_corruption_seeds",
    "overall": "equal_weight_mean_over_corruption_families"
  }
}
